{
  "name": "ale",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "ALE. — PWA per il benessere personale",
  "scripts": {
    "test": "node --test tests/static/ tests/unit/",
    "serve": "node tools/serve-subpath.mjs",
    "vendor": "node tools/vendor.mjs",
    "db:start": "supabase start -x studio,imgproxy,vector,logflare,edge-runtime,realtime,postgres-meta,supavisor",
    "db:test": "supabase test db",
    "db:stop": "supabase stop",
    "test:api": "node --test --test-concurrency=1 tests/api/",
    "precache": "node tools/update-sw-precache.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "supabase": "^3.4.0",
    "ws": "^8.23.0"
  }
}
